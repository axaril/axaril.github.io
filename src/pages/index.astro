---
import "../styles/global.css";

const links = [
  { label: "Resume", href: "/assets/resume.pdf", hint: "PDF" },
  { label: "GitHub", href: "https://github.com/Axaril", hint: "Axaril" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/an-tran-ct", hint: "an-tran-ct" },
  { label: "Email", href: "mailto:antran.ct@proton.me", hint: "antran.ct@proton.me" },
];

const experience = [
  { role: "Software Engineer", org: "Everpure", when: "2023 - now" },
  { role: "Software Engineer Intern", org: "Green Hills Software", when: "2022" },
  { role: "Software Engineer Intern", org: "SprintRay Inc.", when: "2021" },
  { role: "Head Teaching Assistant, CS24", org: "Caltech", when: "2021 - 2023" },
];

// Scaffolding: fill in the real projects.
const projects = [
  { title: "Silicate", blurb: "Pure Rust GPU image compositor for Procreate file format.", href: "https://github.com/axaril/silicate", hint: "github.com/Axaril/…" },
  { title: "bvr", blurb: "Chew through logs with a pager written in Rust.", href: "https://github.com/axaril/bvr", hint: "github.com/Axaril/…" },
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>An Tran – Software Engineer</title>
    <meta name="author" content="An Tran (Avarel)" />
    <meta
      name="description"
      content="Software engineer at Everpure. Computer science, Caltech 2023."
    />
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark")
          document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/assets/icons/favicon-32x32.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/assets/icons/apple-touch-icon.png"
    />
  </head>

  <body>
    <canvas id="dots" aria-hidden="true"></canvas>
    <div class="page">
    <main>
      <button type="button" class="theme-toggle" id="theme-toggle" hidden>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
      <header>
        <h1>An Tran</h1>
        <p class="tagline">
          Software engineer at Everpure, compilers &amp; tooling,
          machine learning, infrastructure.
        </p>
        <ul class="links">
          {
            links.map((l) => (
              <li>
                <a href={l.href}>
                  <span>{l.label}</span>
                  <span class="hint">{l.hint}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </header>

      <div class="details">
        <section>
          <h2>Experience</h2>
          <ul class="entries">
            {
              experience.map((e) => (
                <li>
                  <span class="what">
                    {e.role}
                    <small>{e.org}</small>
                  </span>
                  <span class="when">{e.when}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2>Education</h2>
          <ul class="entries">
            <li>
              <span class="what">
                B.S. Computer Science
                <small>California Institute of Technology</small>
              </span>
              <span class="when">2023</span>
            </li>
          </ul>
        </section>

        <section>
          <h2>Currently working on</h2>
          <code id="splash">Waiting for my code to compile...</code>
        </section>
      </div>
    </main>

    <ul class="projects">
      {
        projects.map((p) => (
          <li>
            <a class="card" href={p.href}>
              <h3>{p.title}</h3>
              <p>{p.blurb}</p>
              <span class="hint">{p.hint}</span>
            </a>
          </li>
        ))
      }
    </ul>
    </div>

    <script>
      import "../scripts/theme.ts";
      import { DotGrid } from "../scripts/dots.ts";
      import "../scripts/splash.ts";

      new DotGrid(document.getElementById("dots") as HTMLCanvasElement);
    </script>
  </body>
</html>
