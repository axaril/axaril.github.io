---
import "../styles/global.css";

const links = [
  { label: "Resume", href: "/assets/resume.pdf" },
  { label: "GitHub", href: "https://github.com/Axaril" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/an-tran-ct" },
  { label: "Email", href: "mailto:antran.ct@proton.me" },
];

const experience = [
  { role: "Software Engineer", org: "Everpure", when: "2023 – now" },
  { role: "Software Engineer Intern", org: "Green Hills Software", when: "2022" },
  { role: "Software Engineer Intern", org: "SprintRay Inc.", when: "2021" },
  { role: "Head TA, CS24", org: "Caltech", when: "2021 – 2023" },
  { role: "Teaching Assistant, CS3", org: "Caltech", when: "2021 – 2022" },
  { role: "Undergraduate Researcher", org: "Caltech", when: "2020" },
];

const splashes = [
  "Learning how to setup GPU pipelines...",
  "Debugging my personal death ray code...",
  "Copy and pasting from Stack Overflow...",
  "Testing on production environment...",
  "Crying because concurrent programming is hard...",
  "Bashing my head to understand OS internals...",
  "Evangelizing the Rust programming language...",
  "Voodoo programming...",
  "Wishing I have time for art instead...",
  "Reaching to you about your car's extended warranty...",
  "Becoming the best that there ever was...",
  "Wishing for a thought-to-program mind reading machine...",
  "Adding gotos to my code and discovering velociraptors...",
  "Trying to exit vim...",
  "Programming using a magnetized needle and a steady hand...",
  "Using butterflies, eddy currents, and cosmic rays...",
  "Segmentation fault (core dumped)",
  "Waiting for my code to compile...",
  "Waiting to reach my Ballmer's peak...",
  "Finding what DenverCoder9 saw on that fateful day...",
  "Looking at the same manual page for the 10th time today...",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>An Tran – Software Engineer</title>
    <meta name="author" content="An Tran (Avarel)" />
    <meta
      name="description"
      content="Software engineer at Everpure. Computer science, Caltech 2023."
    />
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark")
          document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/assets/icons/favicon-32x32.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/assets/icons/apple-touch-icon.png"
    />
  </head>

  <body>
    <button type="button" class="theme-toggle" id="theme-toggle" hidden>
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        ></path>
      </svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </button>
    <main>
      <header>
        <h1>An Tran</h1>
        <p class="tagline">
          Software engineer at Everpure, compilers &amp; tooling,
          machine learning, infrastructure.
        </p>
        <ul class="links">
          {
            links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </header>

      <section>
        <h2>Experience</h2>
        <ul class="entries">
          {
            experience.map((e) => (
              <li>
                <span class="what">
                  {e.role}
                  <small>{e.org}</small>
                </span>
                <span class="when">{e.when}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Education</h2>
        <ul class="entries">
          <li>
            <span class="what">
              B.S. Computer Science
              <small>California Institute of Technology</small>
            </span>
            <span class="when">2023</span>
          </li>
        </ul>
      </section>

      <section>
        <h2>Currently working on</h2>
        <code id="splash">Waiting for my code to compile...</code>
      </section>
    </main>

    <script is:inline>
      const root = document.documentElement;
      const toggle = document.getElementById("theme-toggle");
      const dark = matchMedia("(prefers-color-scheme: dark)");
      const current = () =>
        root.dataset.theme || (dark.matches ? "dark" : "light");
      const render = () => {
        const next = current() === "dark" ? "light" : "dark";
        toggle.dataset.next = next;
        toggle.setAttribute("aria-label", `Switch to ${next} mode`);
      };
      toggle.hidden = false;
      const apply = (next) => {
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
        render();
      };
      toggle.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        const animate =
          document.startViewTransition &&
          !matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!animate) return apply(next);

        // Expand the new theme as a circle from the button.
        const box = toggle.getBoundingClientRect();
        const x = box.left + box.width / 2;
        const y = box.top + box.height / 2;
        const radius = Math.hypot(
          Math.max(x, innerWidth - x),
          Math.max(y, innerHeight - y),
        );
        const transition = document.startViewTransition(() => apply(next));
        transition.ready.then(() =>
          root.animate(
            {
              clipPath: [
                `circle(0px at ${x}px ${y}px)`,
                `circle(${radius}px at ${x}px ${y}px)`,
              ],
            },
            {
              duration: 600,
              easing: "ease-in-out",
              pseudoElement: "::view-transition-new(root)",
            },
          ),
        );
      });
      dark.addEventListener("change", render);
      render();
    </script>
    <script is:inline define:vars={{ splashes }}>
      document.getElementById("splash").textContent =
        splashes[Math.floor(Math.random() * splashes.length)];
    </script>
  </body>
</html>
